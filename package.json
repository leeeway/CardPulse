{
  "name": "card-pulse",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Next-Gen Privacy-First Credit Card Statement Analyzer & Cashback Ledger (多币种信用卡电子结单本地解析与返现中枢)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "desktop:win": "npm run build && electron-builder --win --x64 --publish never",
    "test:desktop": "node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.2.6",
    "vite": "^6.4.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.20.0"
  },
  "main": "desktop/main.cjs",
  "author": "CardPulse contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/leeeway/CardPulse.git"
  }
}
